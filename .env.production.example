# Ejemplo de .env para PRODUCCIÓN (Hostinger) y para el entorno local "igual a producción".
# Copia a .env, completa los valores y genera la llave con: php artisan key:generate
# Nunca subas el .env real al repositorio.

APP_NAME=Marcaje
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[tu-subdominio]

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marcaje
DB_USERNAME=marcaje
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=log
